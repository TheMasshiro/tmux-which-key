K	move	.	0	Display move and resize menu	if-shell -F "#{pane_floating_flag}" { display-menu -T "#[align=centre]Move & Resize" -x P -y P Fill 0 { resize-pane -x "100%" -y "100%" ; move-pane -P top-left } '' "Top Left" 1 { resize-pane -x "50%" -y "50%" ; move-pane -P top-left } "Top Right" 2 { resize-pane -x "50%" -y "50%" ; move-pane -P top-right } "Bottom Left" 3 { resize-pane -x "50%" -y "50%" ; move-pane -P bottom-left } "Bottom Right" 4 { resize-pane -x "50%" -y "50%" ; move-pane -P bottom-right } '' Top t { resize-pane -x "100%" -y "50%" ; move-pane -P top-centre } Bottom b { resize-pane -x "100%" -y "50%" ; move-pane -P bottom-centre } Left l { resize-pane -x "50%" -y "100%" ; move-pane -P centre-left } Right r { resize-pane -x "50%" -y "100%" ; move-pane -P centre-right } }
K	move	0	0	Move pane to fill the window	resize-pane -x "100%" -y "100%" \; move-pane -P top-left
K	move	1	0	Move pane to top-left corner	move-pane -P top-left
K	move	2	0	Move pane to top-right corner	move-pane -P top-right
K	move	3	0	Move pane to bottom-left corner	move-pane -P bottom-left
K	move	4	0	Move pane to bottom-right corner	move-pane -P bottom-right
K	move	h	0		select-pane -L
K	move	Up	0	Move pane to top	move-pane -P top-centre
K	move	Down	0	Move pane to bottom	move-pane -P bottom-centre
K	move	Left	0	Move pane to left	move-pane -P centre-left
K	move	Right	0	Move pane to right	move-pane -P centre-right
K	move	M-1	0	Move pane to top-left corner and resize	resize-pane -x "50%" -y "50%" \; move-pane -P top-left
K	move	M-2	0	Move pane to top-right corner and resize	resize-pane -x "50%" -y "50%" \; move-pane -P top-right
K	move	M-3	0	Move pane to bottom-left corner and resize	resize-pane -x "50%" -y "50%" \; move-pane -P bottom-left
K	move	M-4	0	Move pane to bottom-right corner and resize	resize-pane -x "50%" -y "50%" \; move-pane -P bottom-right
K	move	M-Up	0	Move pane to top and resize	resize-pane -x "100%" -y "50%" \; move-pane -P top-centre
K	move	M-Down	0	Move pane to bottom and resize	resize-pane -x "100%" -y "50%" \; move-pane -P bottom-centre
K	move	M-Left	0	Move pane to left and resize	resize-pane -x "50%" -y "100%" \; move-pane -P centre-left
K	move	M-Right	0	Move pane to right and resize	resize-pane -x "50%" -y "100%" \; move-pane -P centre-right
K	prefix	Tab	0	Switch to a window	new-pane -E -X 0 -Y 0 -x "75%" -y "30%" \; move-pane -P bottom-centre \; switch-mode -kw
K	prefix	Space	0	Select next layout	next-layout
K	prefix	!	0	Break pane to a new window	break-pane
K	prefix	"	0	Split window vertically	split-window
K	prefix	#	0	List all paste buffers	list-buffers
K	prefix	$	0	Rename current session	command-prompt -I "#S" { rename-session "%%" }
K	prefix	%	0	Split window horizontally	split-window -h
K	prefix	&	0	Kill current window	confirm-before -p "kill-window #W? (y/n)" kill-window
K	prefix	'	0	Prompt for window index to select	command-prompt -p index { select-window -t ":%%" }
K	prefix	(	0	Switch to previous client	switch-client -p
K	prefix	)	0	Switch to next client	switch-client -n
K	prefix	*	0	New floating pane	new-pane
K	prefix	,	0	Rename current window	command-prompt -I "#W" { rename-window "%%" }
K	prefix	-	0	Delete the most recent paste buffer	delete-buffer
K	prefix	.	0	Move the current window	command-prompt { move-window -t "%%" }
K	prefix	/	0	Describe key binding	command-prompt -k -p key { list-keys -1N "%%" }
K	prefix	0	0	Select window 0	select-window -t :=0
K	prefix	1	0	Select window 1	select-window -t :=1
K	prefix	2	0	Select window 2	select-window -t :=2
K	prefix	3	0	Select window 3	select-window -t :=3
K	prefix	4	0	Select window 4	select-window -t :=4
K	prefix	5	0	Select window 5	select-window -t :=5
K	prefix	6	0	Select window 6	select-window -t :=6
K	prefix	7	0	Select window 7	select-window -t :=7
K	prefix	8	0	Select window 8	select-window -t :=8
K	prefix	9	0	Select window 9	select-window -t :=9
K	prefix	:	0	Prompt for a command	command-prompt
K	prefix	;	0	Move to the previously active pane	last-pane
K	prefix	<	0	Display window menu	display-menu -T "#[align=centre]#{window_index}:#{window_name}" -x W -y W "#{?#{>:#{session_windows},1},,-}Swap Left" l { swap-window -t :-1 } "#{?#{>:#{session_windows},1},,-}Swap Right" r { swap-window -t :+1 } "#{?pane_marked_set,,-}Swap Marked" s { swap-window } '' Kill X { kill-window } Respawn R { respawn-window -k } "#{?pane_marked,Unmark,Mark}" m { select-pane -m } Rename n { command-prompt -F -I "#W" { rename-window -t "#{window_id}" "%%" } } '' "New After" w { new-window -a } "New At End" W { new-window }
K	prefix	=	0	Choose a paste buffer from a list	choose-buffer -Z
K	prefix	>	0	Display pane menu	display-menu -T "#[align=centre]#{pane_index} (#{pane_id})" -x P -y P "#{?#{m/r:(copy|view)-mode,#{pane_mode}},Go To Top,}" < { send-keys -X history-top } "#{?#{m/r:(copy|view)-mode,#{pane_mode}},Go To Bottom,}" > { send-keys -X history-bottom } '' "#{?#{==:#{pane_mode},copy-mode},#{?copy_line_numbers,Hide Line Numbers,Show Line Numbers},}" L { send-keys -X line-numbers-toggle } "#{?#{==:#{pane_mode},copy-mode},#{?refresh_active,Refresh Off,Refresh On},}" r { send-keys -X refresh-toggle } '' "#{?#{&&:#{buffer_size},#{!:#{pane_in_mode}}},Paste #[underscore]#{=/9/...:buffer_sample},}" p { paste-buffer } '' "#{?mouse_word,Search For #[underscore]#{=/9/...:mouse_word},}" C-r { if-shell -F "#{?#{m/r:(copy|view)-mode,#{pane_mode}},0,1}" "copy-mode -t=" ; send-keys -X -t = search-backward -- "#{q:mouse_word}" } "#{?mouse_word,Type #[underscore]#{=/9/...:mouse_word},}" C-y { copy-mode -q ; send-keys -l "#{q:mouse_word}" } "#{?mouse_word,Copy #[underscore]#{=/9/...:mouse_word},}" c { copy-mode -q ; set-buffer "#{q:mouse_word}" } "#{?mouse_line,Copy Line,}" l { copy-mode -q ; set-buffer "#{q:mouse_line}" } '' "#{?mouse_hyperlink,Type #[underscore]#{=/9/...:mouse_hyperlink},}" C-h { copy-mode -q ; send-keys -l "#{q:mouse_hyperlink}" } "#{?mouse_hyperlink,Copy #[underscore]#{=/9/...:mouse_hyperlink},}" h { copy-mode -q ; set-buffer "#{q:mouse_hyperlink}" } '' "#{?#{#{pane_floating_flag}},Move,}" '' { display-menu -T "#[align=centre]Move" -x L -y L Centre c { move-pane -P centre } '' "Top Left" 1 { move-pane -P top-left } "Top Right" 2 { move-pane -P top-right } "Bottom Left" 3 { move-pane -P bottom-left } "Bottom Right" 4 { move-pane -P bottom-right } '' Top t { move-pane -P top-centre } Bottom b { move-pane -P bottom-centre } Left l { move-pane -P centre-left } Right r { move-pane -P centre-right } } "#{?#{#{pane_floating_flag}},Move & Resize,}" '' { display-menu -T "#[align=centre]Move & Resize" -x L -y L Fill 0 { resize-pane -x "100%" -y "100%" ; move-pane -P top-left } '' "Top Left" 1 { resize-pane -x "50%" -y "50%" ; move-pane -P top-left } "Top Right" 2 { resize-pane -x "50%" -y "50%" ; move-pane -P top-right } "Bottom Left" 3 { resize-pane -x "50%" -y "50%" ; move-pane -P bottom-left } "Bottom Right" 4 { resize-pane -x "50%" -y "50%" ; move-pane -P bottom-right } '' Top t { resize-pane -x "100%" -y "50%" ; move-pane -P top-centre } Bottom b { resize-pane -x "100%" -y "50%" ; move-pane -P bottom-centre } Left l { resize-pane -x "50%" -y "100%" ; move-pane -P centre-left } Right r { resize-pane -x "50%" -y "100%" ; move-pane -P centre-right } } "#{?#{#{pane_floating_flag}},Tile,}" t { join-pane } "#{?#{!:#{pane_floating_flag}},Float,}" f { break-pane -W } "#{?#{!:#{pane_floating_flag}},Horizontal Split,}" h { split-window -h } "#{?#{!:#{pane_floating_flag}},Vertical Split,}" v { split-window -v } '' "#{?#{&&:#{!:#{pane_floating_flag}},#{>:#{window_panes},1}},Swap Up,}" u { swap-pane -U } "#{?#{&&:#{!:#{pane_floating_flag}},#{>:#{window_panes},1}},Swap Down,}" d { swap-pane -D } "#{?pane_marked_set,,-}Swap Marked" s { swap-pane } '' Kill X { kill-pane } Respawn R { respawn-pane -k } "#{?pane_marked,Unmark,Mark}" m { select-pane -m } "#{?#{>:#{window_panes},1},,-}#{?window_zoomed_flag,Unzoom,Zoom}" z { resize-pane -Z }
K	prefix	?	0	List key bindings	list-keys -N
K	prefix	@	0	Toggle pane between floating and tiled	if-shell -F "#{pane_floating_flag}" { join-pane } { break-pane -W }
K	prefix	C	0	Customize options	customize-mode -Z
K	prefix	D	0	Choose and detach a client from a list	choose-client -Z
K	prefix	E	0	Spread panes out evenly	select-layout -E
K	prefix	L	0	Switch to the last client	switch-client -l
K	prefix	M	0	Clear the marked pane	select-pane -M
K	prefix	R	0		run-shell /home/masshiro/bin/deploy-site.sh
K	prefix	T	0	Change the pane title	command-prompt -I "#T" { select-pane -T "%%" }
K	prefix	[	0	Enter copy mode	copy-mode
K	prefix	]	0	Paste the most recent paste buffer	paste-buffer -p
K	prefix	c	0	Create a new window	new-window
K	prefix	d	0	Detach the current client	detach-client
K	prefix	f	0	Search for a pane	command-prompt { find-window -Z "%%" }
K	prefix	g	0	Move a floating pane	switch-client -T move
K	prefix	h	1		resize-pane -L 5
K	prefix	i	0	Display window information	display-message
K	prefix	l	0	Select the previously current window	last-window
K	prefix	m	0	Toggle the marked pane	select-pane -m
K	prefix	n	0	Open notes	run-shell /home/masshiro/bin/notes.sh
K	prefix	o	0	Select the next pane	select-pane -t :.+
K	prefix	p	0	Select the previous window	previous-window
K	prefix	q	0	Display pane numbers	display-panes
K	prefix	r	0	Redraw the current client	refresh-client
K	prefix	s	0	Choose a session from a list	choose-tree -Zs
K	prefix	t	0	Show a clock	clock-mode
K	prefix	w	0	Choose a window from a list	choose-tree -Zw
K	prefix	x	0	Kill the active pane	confirm-before -p "kill-pane #P? (y/n)" kill-pane
K	prefix	z	0	Zoom the active pane	resize-pane -Z
K	prefix	{	0	Swap the active pane with the pane above	swap-pane -U
K	prefix	}	0	Swap the active pane with the pane below	swap-pane -D
K	prefix	~	0	Show messages	show-messages
K	prefix	DC	1	Reset so the visible part of the window follows the cursor	refresh-client -c
K	prefix	PPage	0	Enter copy mode and scroll up	copy-mode -u
K	prefix	BTab	0	Switch to a session	new-pane -E -X 0 -Y 0 -x "75%" -y "30%" \; move-pane -P bottom-centre \; switch-mode -ks
K	prefix	Up	1	Select the pane above the active pane	select-pane -U
K	prefix	Down	1	Select the pane below the active pane	select-pane -D
K	prefix	Left	1	Select the pane to the left of the active pane	select-pane -L
K	prefix	Right	1	Select the pane to the right of the active pane	select-pane -R
K	prefix	M-1	0	Set the even-horizontal layout	select-layout even-horizontal
K	prefix	M-2	0	Set the even-vertical layout	select-layout even-vertical
K	prefix	M-3	0	Set the main-horizontal layout	select-layout main-horizontal
K	prefix	M-4	0	Set the main-vertical layout	select-layout main-vertical
K	prefix	M-5	0	Select the tiled layout	select-layout tiled
K	prefix	M-6	0	Set the main-horizontal-mirrored layout	select-layout main-horizontal-mirrored
K	prefix	M-7	0	Set the main-vertical-mirrored layout	select-layout main-vertical-mirrored
K	prefix	M-n	0	Select the next window with an alert	next-window -a
K	prefix	M-o	0	Rotate through the panes in reverse	rotate-window -D
K	prefix	M-p	0	Select the previous window with an alert	previous-window -a
K	prefix	M-Up	1	Resize the pane up by 5	if-shell -F "#{?floating_pane_flag}" { resize-pane -D -5 } { resize-pane -U 5 }
K	prefix	M-Down	1	Resize the pane down by 5	resize-pane -D 5
K	prefix	M-Left	1	Resize the pane left by 5	if-shell -F "#{?floating_pane_flag}" { resize-pane -R -5 } { resize-pane -L 5 }
K	prefix	M-Right	1	Resize the pane right by 5	resize-pane -R 5
K	prefix	C-b	0	Send the prefix key	send-prefix
K	prefix	C-o	0	Rotate through the panes	rotate-window
K	prefix	C-z	0	Suspend the current client	suspend-client
K	prefix	C-Up	1	Resize the pane up	if-shell -F "#{?floating_pane_flag}" { resize-pane -D -1 } { resize-pane -U -- }
K	prefix	C-Down	1	Resize the pane down	resize-pane -D --
K	prefix	C-Left	1	Resize the pane left	if-shell -F "#{?floating_pane_flag}" { resize-pane -R -1 } { resize-pane -L -- }
K	prefix	C-Right	1	Resize the pane right	resize-pane -R --
K	prefix	S-Up	1	Move the visible part of the window up	refresh-client -U 10
K	prefix	S-Down	1	Move the visible part of the window down	refresh-client -D 10
K	prefix	S-Left	1	Move the visible part of the window left	refresh-client -L 10
K	prefix	S-Right	1	Move the visible part of the window right	refresh-client -R 10
K	root	MouseDown1Pane	0		select-pane -t = \; send-keys -M
K	root	MouseDown1Status	0		switch-client -t =
K	root	MouseDown1Border	0		select-pane -t =
K	root	MouseDown1ScrollbarUp	0		if-shell -F -t = "#{pane_in_mode}" { send-keys -X page-up } { copy-mode -u }
K	root	MouseDown1ScrollbarDown	0		if-shell -F -t = "#{pane_in_mode}" { send-keys -X page-down } { copy-mode -d }
K	root	MouseDown1Control7	0		if-shell -F -t = "#{pane_floating_flag}" { join-pane } { break-pane -W }
K	root	MouseDown1Control8	0		resize-pane -Z
K	root	MouseDown1Control9	0		display-menu -O -T "Kill pane #{pane_index}?" -t = -x M -y M Yes y { kill-pane -t = } No n {  }
K	root	MouseDown2Pane	0		select-pane -t = \; if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send-keys -M } { paste-buffer -p }
K	root	MouseDown3Pane	0		if-shell -F -t = "#{||:#{mouse_any_flag},#{&&:#{pane_in_mode},#{?#{m/r:(copy|view)-mode,#{pane_mode}},0,1}}}" { select-pane -t = ; send-keys -M } { display-menu -T "#[align=centre]#{pane_index} (#{pane_id})" -t = -x M -y M "#{?#{m/r:(copy|view)-mode,#{pane_mode}},Go To Top,}" < { send-keys -X history-top } "#{?#{m/r:(copy|view)-mode,#{pane_mode}},Go To Bottom,}" > { send-keys -X history-bottom } '' "#{?#{==:#{pane_mode},copy-mode},#{?copy_line_numbers,Hide Line Numbers,Show Line Numbers},}" L { send-keys -X line-numbers-toggle } "#{?#{==:#{pane_mode},copy-mode},#{?refresh_active,Refresh Off,Refresh On},}" r { send-keys -X refresh-toggle } '' "#{?#{&&:#{buffer_size},#{!:#{pane_in_mode}}},Paste #[underscore]#{=/9/...:buffer_sample},}" p { paste-buffer } '' "#{?mouse_word,Search For #[underscore]#{=/9/...:mouse_word},}" C-r { if-shell -F "#{?#{m/r:(copy|view)-mode,#{pane_mode}},0,1}" "copy-mode -t=" ; send-keys -X -t = search-backward -- "#{q:mouse_word}" } "#{?mouse_word,Type #[underscore]#{=/9/...:mouse_word},}" C-y { copy-mode -q ; send-keys -l "#{q:mouse_word}" } "#{?mouse_word,Copy #[underscore]#{=/9/...:mouse_word},}" c { copy-mode -q ; set-buffer "#{q:mouse_word}" } "#{?mouse_line,Copy Line,}" l { copy-mode -q ; set-buffer "#{q:mouse_line}" } '' "#{?mouse_hyperlink,Type #[underscore]#{=/9/...:mouse_hyperlink},}" C-h { copy-mode -q ; send-keys -l "#{q:mouse_hyperlink}" } "#{?mouse_hyperlink,Copy #[underscore]#{=/9/...:mouse_hyperlink},}" h { copy-mode -q ; set-buffer "#{q:mouse_hyperlink}" } '' "#{?#{#{pane_floating_flag}},Move,}" '' { display-menu -T "#[align=centre]Move" -x L -y L Centre c { move-pane -P centre } '' "Top Left" 1 { move-pane -P top-left } "Top Right" 2 { move-pane -P top-right } "Bottom Left" 3 { move-pane -P bottom-left } "Bottom Right" 4 { move-pane -P bottom-right } '' Top t { move-pane -P top-centre } Bottom b { move-pane -P bottom-centre } Left l { move-pane -P centre-left } Right r { move-pane -P centre-right } } "#{?#{#{pane_floating_flag}},Move & Resize,}" '' { display-menu -T "#[align=centre]Move & Resize" -x L -y L Fill 0 { resize-pane -x "100%" -y "100%" ; move-pane -P top-left } '' "Top Left" 1 { resize-pane -x "50%" -y "50%" ; move-pane -P top-left } "Top Right" 2 { resize-pane -x "50%" -y "50%" ; move-pane -P top-right } "Bottom Left" 3 { resize-pane -x "50%" -y "50%" ; move-pane -P bottom-left } "Bottom Right" 4 { resize-pane -x "50%" -y "50%" ; move-pane -P bottom-right } '' Top t { resize-pane -x "100%" -y "50%" ; move-pane -P top-centre } Bottom b { resize-pane -x "100%" -y "50%" ; move-pane -P bottom-centre } Left l { resize-pane -x "50%" -y "100%" ; move-pane -P centre-left } Right r { resize-pane -x "50%" -y "100%" ; move-pane -P centre-right } } "#{?#{#{pane_floating_flag}},Tile,}" t { join-pane } "#{?#{!:#{pane_floating_flag}},Float,}" f { break-pane -W } "#{?#{!:#{pane_floating_flag}},Horizontal Split,}" h { split-window -h } "#{?#{!:#{pane_floating_flag}},Vertical Split,}" v { split-window -v } '' "#{?#{&&:#{!:#{pane_floating_flag}},#{>:#{window_panes},1}},Swap Up,}" u { swap-pane -U } "#{?#{&&:#{!:#{pane_floating_flag}},#{>:#{window_panes},1}},Swap Down,}" d { swap-pane -D } "#{?pane_marked_set,,-}Swap Marked" s { swap-pane } '' Kill X { kill-pane } Respawn R { respawn-pane -k } "#{?pane_marked,Unmark,Mark}" m { select-pane -m } "#{?#{>:#{window_panes},1},,-}#{?window_zoomed_flag,Unzoom,Zoom}" z { resize-pane -Z } }
K	root	MouseDown3Status	0		display-menu -T "#[align=centre]#{window_index}:#{window_name}" -t = -x W -y W "#{?#{>:#{session_windows},1},,-}Swap Left" l { swap-window -t :-1 } "#{?#{>:#{session_windows},1},,-}Swap Right" r { swap-window -t :+1 } "#{?pane_marked_set,,-}Swap Marked" s { swap-window } '' Kill X { kill-window } Respawn R { respawn-window -k } "#{?pane_marked,Unmark,Mark}" m { select-pane -m } Rename n { command-prompt -F -I "#W" { rename-window -t "#{window_id}" "%%" } } '' "New After" w { new-window -a } "New At End" W { new-window }
K	root	MouseDown3StatusLeft	0		run-shell -C "display-menu -t= -xM -yW -T '#[align=centre]#{session_name}'  #{S/t:#{?#{&&:#{<:#{loop_index},6},#{!:#{session_active}}},'Switch To #[underscore]#{session_name}' '' {switch-client -t=#{session_id}#} ,}} '' 'Renumber' 'N' {move-window -r} 'Rename' 'r' {command-prompt -I '#S' {rename-session -- '%%'}} 'Detach' 'd' {detach-client} '' 'New Session' 's' {new-session} 'New Window' 'w' {new-window}"
K	root	MouseDown3Empty	0		display-menu -T "#[align=centre]#{window_index}:#{window_name}" -t = -x M -y M "New Pane" p { new-pane ; join-pane } "New Window" w { new-window }
K	root	MouseDrag1Pane	0		if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send-keys -M } { copy-mode -M }
K	root	MouseDrag1Border	0		resize-pane -M
K	root	MouseDrag1ScrollbarSlider	0		if-shell -F -t = "#{pane_in_mode}" { send-keys -X scroll-to-mouse } { copy-mode -S }
K	root	WheelDownStatus	0		next-window
K	root	WheelUpPane	0		if-shell -F "#{||:#{alternate_on},#{pane_in_mode},#{mouse_any_flag}}" { send-keys -M } { copy-mode -e }
K	root	WheelUpStatus	0		previous-window
K	root	DoubleClick1Pane	0		select-pane -t = \; if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send-keys -M } { copy-mode -H ; send-keys -X select-word ; run-shell -d 0.3 ; send-keys -X copy-pipe-and-cancel }
K	root	TripleClick1Pane	0		select-pane -t = \; if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send-keys -M } { copy-mode -H ; send-keys -X select-line ; run-shell -d 0.3 ; send-keys -X copy-pipe-and-cancel }
K	root	M-MouseDown3Pane	0		display-menu -T "#[align=centre]#{pane_index} (#{pane_id})" -t = -x M -y M "#{?#{m/r:(copy|view)-mode,#{pane_mode}},Go To Top,}" < { send-keys -X history-top } "#{?#{m/r:(copy|view)-mode,#{pane_mode}},Go To Bottom,}" > { send-keys -X history-bottom } '' "#{?#{==:#{pane_mode},copy-mode},#{?copy_line_numbers,Hide Line Numbers,Show Line Numbers},}" L { send-keys -X line-numbers-toggle } "#{?#{==:#{pane_mode},copy-mode},#{?refresh_active,Refresh Off,Refresh On},}" r { send-keys -X refresh-toggle } '' "#{?#{&&:#{buffer_size},#{!:#{pane_in_mode}}},Paste #[underscore]#{=/9/...:buffer_sample},}" p { paste-buffer } '' "#{?mouse_word,Search For #[underscore]#{=/9/...:mouse_word},}" C-r { if-shell -F "#{?#{m/r:(copy|view)-mode,#{pane_mode}},0,1}" "copy-mode -t=" ; send-keys -X -t = search-backward -- "#{q:mouse_word}" } "#{?mouse_word,Type #[underscore]#{=/9/...:mouse_word},}" C-y { copy-mode -q ; send-keys -l "#{q:mouse_word}" } "#{?mouse_word,Copy #[underscore]#{=/9/...:mouse_word},}" c { copy-mode -q ; set-buffer "#{q:mouse_word}" } "#{?mouse_line,Copy Line,}" l { copy-mode -q ; set-buffer "#{q:mouse_line}" } '' "#{?mouse_hyperlink,Type #[underscore]#{=/9/...:mouse_hyperlink},}" C-h { copy-mode -q ; send-keys -l "#{q:mouse_hyperlink}" } "#{?mouse_hyperlink,Copy #[underscore]#{=/9/...:mouse_hyperlink},}" h { copy-mode -q ; set-buffer "#{q:mouse_hyperlink}" } '' "#{?#{#{pane_floating_flag}},Move,}" '' { display-menu -T "#[align=centre]Move" -x L -y L Centre c { move-pane -P centre } '' "Top Left" 1 { move-pane -P top-left } "Top Right" 2 { move-pane -P top-right } "Bottom Left" 3 { move-pane -P bottom-left } "Bottom Right" 4 { move-pane -P bottom-right } '' Top t { move-pane -P top-centre } Bottom b { move-pane -P bottom-centre } Left l { move-pane -P centre-left } Right r { move-pane -P centre-right } } "#{?#{#{pane_floating_flag}},Move & Resize,}" '' { display-menu -T "#[align=centre]Move & Resize" -x L -y L Fill 0 { resize-pane -x "100%" -y "100%" ; move-pane -P top-left } '' "Top Left" 1 { resize-pane -x "50%" -y "50%" ; move-pane -P top-left } "Top Right" 2 { resize-pane -x "50%" -y "50%" ; move-pane -P top-right } "Bottom Left" 3 { resize-pane -x "50%" -y "50%" ; move-pane -P bottom-left } "Bottom Right" 4 { resize-pane -x "50%" -y "50%" ; move-pane -P bottom-right } '' Top t { resize-pane -x "100%" -y "50%" ; move-pane -P top-centre } Bottom b { resize-pane -x "100%" -y "50%" ; move-pane -P bottom-centre } Left l { resize-pane -x "50%" -y "100%" ; move-pane -P centre-left } Right r { resize-pane -x "50%" -y "100%" ; move-pane -P centre-right } } "#{?#{#{pane_floating_flag}},Tile,}" t { join-pane } "#{?#{!:#{pane_floating_flag}},Float,}" f { break-pane -W } "#{?#{!:#{pane_floating_flag}},Horizontal Split,}" h { split-window -h } "#{?#{!:#{pane_floating_flag}},Vertical Split,}" v { split-window -v } '' "#{?#{&&:#{!:#{pane_floating_flag}},#{>:#{window_panes},1}},Swap Up,}" u { swap-pane -U } "#{?#{&&:#{!:#{pane_floating_flag}},#{>:#{window_panes},1}},Swap Down,}" d { swap-pane -D } "#{?pane_marked_set,,-}Swap Marked" s { swap-pane } '' Kill X { kill-pane } Respawn R { respawn-pane -k } "#{?pane_marked,Unmark,Mark}" m { select-pane -m } "#{?#{>:#{window_panes},1},,-}#{?window_zoomed_flag,Unzoom,Zoom}" z { resize-pane -Z }
K	root	M-MouseDown3Status	0		display-menu -T "#[align=centre]#{window_index}:#{window_name}" -t = -x W -y W "#{?#{>:#{session_windows},1},,-}Swap Left" l { swap-window -t :-1 } "#{?#{>:#{session_windows},1},,-}Swap Right" r { swap-window -t :+1 } "#{?pane_marked_set,,-}Swap Marked" s { swap-window } '' Kill X { kill-window } Respawn R { respawn-window -k } "#{?pane_marked,Unmark,Mark}" m { select-pane -m } Rename n { command-prompt -F -I "#W" { rename-window -t "#{window_id}" "%%" } } '' "New After" w { new-window -a } "New At End" W { new-window }
K	root	M-MouseDown3StatusLeft	0		run-shell -C "display-menu -t= -xM -yW -T '#[align=centre]#{session_name}'  #{S/t:#{?#{&&:#{<:#{loop_index},6},#{!:#{session_active}}},'Switch To #[underscore]#{session_name}' '' {switch-client -t=#{session_id}#} ,}} '' 'Renumber' 'N' {move-window -r} 'Rename' 'r' {command-prompt -I '#S' {rename-session -- '%%'}} 'Detach' 'd' {detach-client} '' 'New Session' 's' {new-session} 'New Window' 'w' {new-window}"
K	root	M-MouseDown3Empty	0		display-menu -T "#[align=centre]#{window_index}:#{window_name}" -t = -x M -y M "New Pane" p { new-pane ; join-pane } "New Window" w { new-window }
K	root	M-MouseDrag1Pane	0		move-pane -M
K	root	M-MouseDrag1Border	0		move-pane -M
K	root	C-MouseDown1Status	0		swap-window -t @
K	root	C-MouseDrag1Pane	0		new-pane -M
K	root	C-MouseDrag1Empty	0		new-pane -M
@which-key-M-h "Htop : popup:htop"
@which-key-g-L "Lazygit : popup:lazygit"
@which-key-g-S "Stash : git stash"
@which-key-g-s "Status : git status"
@which-key-group-M Tools
@which-key-group-b none
@which-key-group-g Git
@which-key-group-p Panes
@which-key-icons off
@which-key-p-Q "Quote : tmux:display-message \"a \\\"b\\\" \$HOME; c\""
@which-key-p-z none
@which-key-root-f "Files : run:yazi"
@which-key-y-x "Orphan : echo"
